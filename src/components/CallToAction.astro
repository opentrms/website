---
interface Props {
  title?: string;
}
const { title = "See the system before you commit a line of code." } = Astro.props;

const videoUrl = 'https://docs.opentrms.com/learn/get-started/getting-started';
---

<section id="contact" class="section-padding relative overflow-hidden" style="background-color: var(--wb-bg-panel); border-top: 1px solid var(--wb-border-subtle);">
  <div aria-hidden="true" class="absolute inset-0 opacity-30 pointer-events-none"
    style="background-image: radial-gradient(60% 50% at 50% 100%, rgba(20,184,166,0.18) 0%, transparent 70%);">
  </div>

  <div class="relative container-narrow mx-auto text-center">
    <span class="badge font-mono tracking-[0.16em] uppercase"
      style="color: var(--wb-accent); background-color: var(--wb-accent-muted); border: 1px solid var(--wb-border-subtle);"
    >
      20-part video series
    </span>

    <h2 class="mt-6 text-3xl md:text-4xl font-semibold tracking-tight text-wb-fg max-w-3xl mx-auto leading-tight">
      {title}
    </h2>
    <p class="mt-5 text-lg text-wb-fg-secondary max-w-xl mx-auto leading-relaxed">
      Twenty short videos recorded against the running system — deal capture, lifecycle
      events, the audit trail, EOD batch and the AI control room. Screen recordings throughout,
      so you are judging the software rather than a deck.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href={videoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary px-7 py-4 text-base">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
        Start the video series
      </a>
      <a href="https://github.com/opentrms/opentrms" target="_blank" rel="noopener noreferrer"
         class="btn-secondary px-7 py-4 text-base">
        Star on GitHub
      </a>
    </div>

    <p class="mt-8 text-xs font-mono uppercase tracking-[0.18em] text-wb-fg-muted">
      Open source · No license metering · Self-hosted from day one
    </p>
  </div>
</section>
