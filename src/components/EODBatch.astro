---
// EODBatch.astro — narrative end-of-day, dark theme
const checkpoints = [
  {
    title: 'Cut-off',
    body: 'Cut-off lands and the desks stop booking. The system snapshots the book at a single, attributable point in time, so every downstream number shares one agreed "as of".',
  },
  {
    title: 'Curves & rates',
    body: 'Fixings come in. Discount and projection curves rebuild from that snapshot. Every input is recorded; every output is reproducible.',
  },
  {
    title: 'Accruals',
    body: 'Interest accrues on every open position. Finance gets numbers that tie back to specific trades on specific days, down to the cashflow.',
  },
  {
    title: 'Mark-to-market',
    body: 'The whole portfolio is valued: IRS, FX, bonds, options. Greeks, DV01, PV01 fall out of the same model your trading desk used yesterday.',
  },
  {
    title: 'Journals & margin',
    body: 'Posting rules turn valuations into journal entries; margin is calculated against the same numbers. Finance and risk see the same truth.',
  },
  {
    title: 'Settlements',
    body: 'Cashflows are netted by counterparty and currency. Payment messages are produced and queued, ready for SWIFT or your bank rails.',
  },
  {
    title: 'Sign-off',
    body: 'Every step is an event, including the ones that were retried or ran late. The next morning\'s regulatory report is pulled from that same trail.',
  },
];
---

<section id="eod" class="section-padding" style="background-color: var(--wb-bg-base);">
  <div class="container-narrow mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14 items-end">
      <div class="lg:col-span-7">
        <span class="section-eyebrow">End-of-day you can trust</span>
        <h2 class="section-title mt-3">Closing the day shouldn't be a leap of faith.</h2>
        <p class="section-subtitle">
          EOD is where most TRMS deployments quietly fall apart — partial runs, mystery breaks,
          finance and risk arguing over whose number is right. OpenTRMS runs EOD as a sequence of
          attributable events, each one reproducible from the same audit trail your auditors will read.
        </p>
      </div>

      <!-- Curve projection tile -->
      <div class="lg:col-span-5">
        <div class="rounded-lg p-5" style="background-color: var(--wb-bg-panel); border: 1px solid var(--wb-border-strong);">
          <div class="flex items-baseline justify-between mb-3">
            <div>
              <div class="text-[11px] font-mono uppercase tracking-[0.18em] text-wb-fg-muted">Curve projection</div>
              <div class="text-sm font-semibold text-wb-fg mt-0.5">USD 3M · today vs T−1</div>
            </div>
            <div class="text-right wb-tabular-nums">
              <div class="text-base font-semibold text-wb-fg">+3.2 <span class="text-wb-fg-muted text-xs">bp</span></div>
              <div class="text-[11px] font-mono" style="color: var(--wb-positive);">▲ steepened</div>
            </div>
          </div>
          <svg viewBox="0 0 320 130" class="w-full h-auto" role="img" aria-label="Curve projection">
            <defs>
              <linearGradient id="eodFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="var(--wb-accent)" stop-opacity="0.28" />
                <stop offset="100%" stop-color="var(--wb-accent)" stop-opacity="0" />
              </linearGradient>
            </defs>
            {[0,0.25,0.5,0.75,1].map((f) => (
              <line x1="28" x2="312" y1={14 + 96 * f} y2={14 + 96 * f} stroke="var(--wb-border-subtle)" stroke-dasharray="2 4" />
            ))}
            <!-- T-1 (faded) -->
            <path d="M 28 78 L 64 70 L 100 60 L 136 56 L 172 60 L 208 65 L 244 70 L 280 73 L 312 76"
              fill="none" stroke="var(--wb-fg-muted)" stroke-width="1.25" stroke-dasharray="3 3" />
            <!-- Today -->
            <path d="M 28 84 L 64 74 L 100 60 L 136 50 L 172 48 L 208 50 L 244 54 L 280 58 L 312 62 L 312 110 L 28 110 Z"
              fill="url(#eodFill)" />
            <path d="M 28 84 L 64 74 L 100 60 L 136 50 L 172 48 L 208 50 L 244 54 L 280 58 L 312 62"
              fill="none" stroke="var(--wb-accent)" stroke-width="1.75" stroke-linejoin="round" />
            {['1M','1Y','5Y','10Y','30Y'].map((t, i) => (
              <text x={28 + (284 * i) / 4} y={124} text-anchor="middle" font-size="9" font-family="var(--wb-font-mono)" fill="var(--wb-fg-muted)">{t}</text>
            ))}
          </svg>
          <div class="mt-3 flex items-center gap-4 text-[11px] font-mono text-wb-fg-secondary">
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-0.5" style="background-color: var(--wb-accent);"></span> today
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-px" style="background-color: var(--wb-fg-muted); border-top: 1px dashed var(--wb-fg-muted);"></span> T−1
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {checkpoints.map((c, i) => (
        <div class="panel">
          <div class="flex items-baseline gap-3">
            <span class="text-xs font-mono" style="color: var(--wb-accent);">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-base font-semibold text-wb-fg">{c.title}</h3>
          </div>
          <p class="mt-2 text-sm text-wb-fg-secondary leading-relaxed">{c.body}</p>
        </div>
      ))}
    </div>

    <p class="mt-10 text-sm text-wb-fg-muted max-w-2xl">
      One trail from cut-off to sign-off. If something needs to be re-run, it's a replay — not a rebuild.
    </p>

  </div>
</section>
