---
// AssetClasses.astro — buyer-framed multi-asset coverage, dark theme
import { assetClasses, instruments } from '../data/asset-classes.ts';
import type { AssetClass } from '../data/asset-classes.ts';

const allCards: AssetClass[] = [
  ...assetClasses,
  { name: 'Instruments', products: instruments },
];
---

<section id="assets" class="section-padding" style="background-color: var(--wb-bg-panel); border-top: 1px solid var(--wb-border-subtle); border-bottom: 1px solid var(--wb-border-subtle);">
  <div class="container-narrow mx-auto">

    <div class="max-w-3xl mb-12">
      <span class="section-eyebrow">Multi-asset coverage</span>
      <h2 class="section-title mt-3">One ledger for everything your treasury actually trades.</h2>
      <p class="section-subtitle">
        Partial coverage is what pushes the remainder of the book into spreadsheets.
        OpenTRMS books FX, money markets, fixed income and derivatives against the same event store,
        so positions, P&amp;L and exposure stay consistent without nightly stitching.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {allCards.map((cls) => (
        <div class="panel">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--wb-accent);"></span>
            <h3 class="text-[11px] font-mono uppercase tracking-[0.18em] text-wb-accent">{cls.name}</h3>
          </div>
          <ul class="mt-5 space-y-3">
            {cls.products.map((product) => (
              <li class="flex items-baseline gap-2">
                <span class="text-wb-fg-muted">›</span>
                <div class="min-w-0">
                  <a
                    href={`https://github.com/opentrms/opentrms/tree/main/${product.schemaPath}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-wb-fg hover:text-wb-accent transition-colors block leading-snug"
                  >
                    {product.name}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-10 text-sm text-wb-fg-muted">
      One position model. One P&amp;L. One audit trail — reconciled by construction rather than at end of day.
    </p>

  </div>
</section>
