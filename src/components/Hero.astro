---
import MarketViz from './MarketViz.astro';
---

<section class="relative w-full overflow-hidden" style="background-color: var(--wb-bg-base);">
  <!-- subtle grid + radial accent -->
  <div aria-hidden="true" class="absolute inset-0 opacity-[0.4] pointer-events-none"
    style="background-image:
      radial-gradient(60% 50% at 50% 0%, rgba(20,184,166,0.16) 0%, transparent 70%),
      linear-gradient(var(--wb-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--wb-border-subtle) 1px, transparent 1px);
      background-size: auto, 48px 48px, 48px 48px;
      mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);">
  </div>

  <div class="relative container-narrow mx-auto px-6 xl:px-0 pt-8 pb-20 md:pt-12 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

      <!-- Copy -->
      <div class="lg:col-span-7">
        <span class="badge font-mono tracking-[0.16em] uppercase"
          style="color: var(--wb-accent); background-color: var(--wb-accent-muted); border: 1px solid var(--wb-border-subtle);"
        >
          Open source
        </span>

        <h1 class="mt-6 text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-wb-fg leading-[1.05]">
          The trading and risk platform
          <br class="hidden md:block" />
          you can <span style="color: var(--wb-accent);">own</span>, audit, and extend.
        </h1>

        <p class="mt-6 text-lg md:text-xl text-wb-fg-secondary max-w-2xl leading-relaxed">
          OpenTRMS runs the full trade lifecycle for FX, money markets, derivatives and
          fixed income — with an immutable audit trail and an AI control room that works inside
          your existing controls. Self-hosted, with every number reproducible from its inputs.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <a href="https://docs.opentrms.com/learn/get-started/getting-started" target="_blank" rel="noopener noreferrer" class="btn-primary px-7 py-4 text-base">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"/>
            </svg>
            See it running
          </a>
          <a href="https://github.com/opentrms/opentrms" target="_blank" rel="noopener noreferrer" class="btn-secondary px-7 py-4 text-base">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            Read the source
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-2.5">
          {['Open source', 'Self-hosted', 'Audit-ready by design', 'AI-native ops'].map((label) => (
            <span class="badge text-xs"
              style="color: var(--wb-fg-secondary); background-color: var(--wb-bg-panel); border: 1px solid var(--wb-border-strong);"
            >{label}</span>
          ))}
        </div>

        <p class="mt-4 text-sm text-wb-fg-muted">
          20 short videos of the real system — start with
          <a href="https://docs.opentrms.com/learn/get-started/getting-started" target="_blank" rel="noopener noreferrer"
             class="underline underline-offset-4 hover:text-wb-fg transition-colors"
             style="text-decoration-color: var(--wb-accent);">Getting started</a>.
        </p>
      </div>

      <!-- Visual: live market dashboard mock -->
      <div class="lg:col-span-5">
        <MarketViz />
      </div>

    </div>
  </div>
</section>
