---
// DeveloperExperience.astro — short pilot path, no H2, no vendor name-drops
const dxFeatures = [
  { label: 'API explorer',     sub: 'Swagger UI at /docs' },
  { label: 'Versioned schema', sub: 'Flyway, forward-only' },
  { label: 'Executable specs', sub: 'Cucumber BDD suite' },
  { label: 'Self-hosted',      sub: 'Open source · your VPC' },
];
---

<section id="pilot" class="section-padding" style="background-color: var(--wb-bg-base);">
  <div class="container-narrow mx-auto">

    <div class="max-w-3xl mb-12">
      <span class="section-eyebrow">From repo to first trade</span>
      <h2 class="section-title mt-3">A pilot you can stand up in an afternoon.</h2>
      <p class="section-subtitle">
        No multi-month implementation project, no rooms full of consultants. Clone the repository,
        bring up the stack with Docker, and book your first trade against a real PostgreSQL ledger.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

      <div class="rounded-lg overflow-hidden" style="background-color: var(--wb-bg-sunken); border: 1px solid var(--wb-border-subtle);">
        <div class="flex items-center gap-2 px-4 py-3" style="background-color: var(--wb-bg-raised); border-bottom: 1px solid var(--wb-border-subtle);">
          <span class="w-2.5 h-2.5 rounded-full" style="background-color: var(--wb-negative);"></span>
          <span class="w-2.5 h-2.5 rounded-full" style="background-color: var(--wb-warning);"></span>
          <span class="w-2.5 h-2.5 rounded-full" style="background-color: var(--wb-positive);"></span>
          <span class="ml-3 text-xs font-mono text-wb-fg-muted">bash</span>
        </div>
        <div class="p-6 font-mono text-[13px] leading-7 text-wb-fg">
          <div><span style="color: var(--wb-accent);">$</span> git clone https://github.com/opentrms/opentrms</div>
          <div><span style="color: var(--wb-accent);">$</span> cd opentrms &amp;&amp; docker compose up -d</div>
          <div><span style="color: var(--wb-accent);">$</span> mvn -pl trms-api spring-boot:run</div>
          <div class="mt-4 pt-4" style="border-top: 1px solid var(--wb-border-subtle);">
            <div><span style="color: var(--wb-positive);">✓</span> <span class="text-wb-fg-secondary">Started TrmsApplication in 4.2s</span></div>
            <div><span style="color: var(--wb-positive);">✓</span> <span class="text-wb-fg-secondary">API explorer →</span> <span style="color: var(--wb-info);">http://localhost:8080/docs</span></div>
            <div><span style="color: var(--wb-positive);">✓</span> <span class="text-wb-fg-secondary">First trade booked · audit trail live</span></div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 content-center">
        {dxFeatures.map((f) => (
          <div class="panel">
            <span class="text-sm font-semibold text-wb-fg">{f.label}</span>
            <span class="block text-xs text-wb-fg-muted mt-1">{f.sub}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
